{
  "name": "kickstart",
  "version": "0.1.0",
  "description": "TODO(kickstart): say in one line what this repository is, and put its name in the name field above.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun --no-env-file scripts/check.ts",
    "check:quick": "bun --no-env-file scripts/check.ts --quick",
    "check:rows": "bun --no-env-file scripts/check.ts --rows",
    "format": "bunx --bun --no-install prettier --config .prettierrc --no-editorconfig --ignore-path .prettierignore --write .",
    "markers": "bun scripts/markers.ts",
    "prepare": "bun ./node_modules/lefthook/bin/index.js install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
